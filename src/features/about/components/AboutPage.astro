---
import AboutCapabilities from "./AboutCapabilities.astro";
import AboutGlobe from "./AboutGlobe.astro";
import AsciiLock from "./AsciiLock.astro";
import { experienceFacts } from "../data/capabilities";

interface Props {
  scrollDriven?: boolean;
  showGlobe?: boolean;
}

const { scrollDriven = false, showGlobe = true } = Astro.props;
const Heading = scrollDriven ? "h2" : "h1";
const Subheading = scrollDriven ? "h3" : "h2";
const CapabilityHeading = scrollDriven ? "h4" : "h3";
const contactHref = scrollDriven ? "#contact" : "/contact#contact";
---

<section
  class:list={["about", { "about--embedded": scrollDriven }]}
  id="about"
  data-about
  data-about-scroll={scrollDriven ? "true" : "false"}
  aria-labelledby="about-title"
  lang="en"
>
  <div class="about__opening">
    <div class="about__frame about__intro">
      <div class="about__intro-copy">
        <Heading class="about__headline" id="about-title">Security at the core<span>.</span></Heading>
        <p>Z3nTry is a technology company with cybersecurity at its core. We test defenses, build secure software, and give brands a clear digital presence.</p>
        <p>We start with what you need to protect, how your team works, and what you want to achieve. Then we decide what to secure, build, or improve first.</p>
      </div>

      {showGlobe ? (
        <div class="about__globe" data-about-globe-wrap>
          <AboutGlobe />
        </div>
      ) : <div class="about__globe about__globe-window" data-globe-about-slot aria-hidden="true"></div>}
    </div>
  </div>

  <div class="about__details" data-about-reading>
    <div class="about__frame">
      <section id="services" aria-labelledby="capabilities-title">
        <div class="about__capability-lead" id="capabilities">
          <Subheading id="capabilities-title">What we do<span>.</span></Subheading>
          <p>Finding a weakness is only the beginning. We help you address what puts your organization at risk, build the tools your team needs, and make your work easier for the right people to find.</p>
        </div>
        <AboutCapabilities heading={CapabilityHeading} />
      </section>

      <AsciiLock />

      <div class="about__record">
        <section class="about__experience" id="experience" aria-labelledby="experience-title">
          <div>
            <Subheading id="experience-title">What experience teaches us</Subheading>
            <p>Working across countries has shown us how differently organizations face similar challenges. A method that works for one team needs to adapt to the systems, people, and risks of the next.</p>
            <p>What we learn in each project shapes how we test defenses, build software, and develop brands for the next one.</p>
          </div>
          <dl class="about__facts">
            {experienceFacts.map(({ value, label }) => (
              <div><dt>{label}</dt><dd>{value}</dd></div>
            ))}
          </dl>
        </section>

        <section class="about__note" aria-labelledby="mindset-title">
          <div>
            <Subheading id="mindset-title">Always one step ahead<span>.</span></Subheading>
            <p>Threats change. We think like attackers and prepare defenders before an incident forces them to react. The goal is to leave your team better prepared for what comes next.</p>
            <a class="signal-link" href={contactHref}>Talk about your project</a>
          </div>
          {!scrollDriven && <svg class="about__signal" viewBox="0 0 256 76" fill="none" aria-hidden="true">
            <path class="about__signal-track" d="M12 57h61l38-38h71l35 35h27" />
            <path class="about__signal-route" pathLength="100" d="M12 57h61l38-38h71l35 35h27" />
            <circle cx="12" cy="57" r="2.5" />
            <circle cx="244" cy="54" r="2.5" />
          </svg>}
        </section>
        {scrollDriven && (
          <svg class="about__signal about__signal--handoff" viewBox="0 0 640 36" fill="none" aria-hidden="true">
            <path class="about__signal-track" d="M4 7H305L327 29H636" />
            <path class="about__signal-route" pathLength="100" d="M4 7H305L327 29H636" />
            <circle cx="4" cy="7" r="2" />
            <circle cx="636" cy="29" r="2" />
          </svg>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  import { setupAboutAnimation } from "../animations/about.gsap";
  import { mountVisibleScene } from "../../../lib/three/mount-visible-scene";

  let cleanupPage = (): void => undefined;
  let currentAbout: HTMLElement | null = null;

  function initializeAbout(): void {
    const root = document.querySelector<HTMLElement>("[data-about]");
    if (root === currentAbout) return;
    cleanupPage();
    if (!root) return;
    currentAbout = root;

    const globe = root.querySelector<HTMLElement>("[data-about-globe]");
    const lock = root.querySelector<HTMLElement>("[data-ascii-lock]");
    const reading = root.querySelector<HTMLElement>("[data-about-reading]");
    const utilities = document.querySelector<HTMLElement>("[data-shell-utilities]");
    const readingObserver = reading && utilities && "IntersectionObserver" in window
      ? new IntersectionObserver(([entry]) => {
          utilities.toggleAttribute("data-about-reading-active", entry.isIntersecting);
        })
      : undefined;
    if (reading) readingObserver?.observe(reading);
    const cleanupAnimation = root.dataset.aboutScroll === "true"
      ? undefined
      : setupAboutAnimation(root);
    const cleanupGlobe = globe
      ? mountVisibleScene(globe, () => import("../animations/about-globe.client").then(({ setupAboutGlobe }) => setupAboutGlobe))
      : undefined;
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let cleanupLock: (() => void) | undefined;
    const syncLock = (): void => {
      cleanupLock?.();
      cleanupLock = lock && !motion.matches
        ? mountVisibleScene(lock, () => import("../animations/ascii-lock.client").then(({ setupAsciiLock }) => setupAsciiLock))
        : undefined;
    };
    syncLock();
    motion.addEventListener("change", syncLock);

    cleanupPage = () => {
      currentAbout = null;
      readingObserver?.disconnect();
      utilities?.removeAttribute("data-about-reading-active");
      cleanupAnimation?.();
      cleanupGlobe?.();
      motion.removeEventListener("change", syncLock);
      cleanupLock?.();
    };
  }

  initializeAbout();
  document.addEventListener("astro:page-load", initializeAbout);
  document.addEventListener("astro:before-swap", () => cleanupPage());
  window.addEventListener("pagehide", () => cleanupPage());
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) initializeAbout();
  });
</script>

<style>
  .about {
    position: relative;
    background: var(--color-void);
  }

  :global([data-shell-utilities][data-about-reading-active]:not(:focus-within)) {
    display: none;
  }

  .about__frame {
    inline-size: var(--page-frame);
    margin-inline: auto;
  }

  .about__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 4vw, 4rem);
    padding-block: clamp(6rem, 9vw, 8rem) clamp(2rem, 5vw, 4rem);
  }

  .about--embedded .about__opening {
    background: linear-gradient(90deg, var(--color-void) 30%, transparent 56%);
  }

  .about__intro-copy {
    pointer-events: auto;
  }

  .about__headline {
    max-inline-size: 13ch;
    font: 700 clamp(2.35rem, 5.6vw, 5.4rem)/0.99 var(--font-display);
    letter-spacing: -0.04em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .about__headline span,
  #capabilities-title span,
  .about__note h3 span,
  .about__note h2 span {
    color: var(--color-signal);
  }

  .about__intro-copy p {
    max-inline-size: 50ch;
    margin-block-start: 1rem;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.45vw, 1.2rem);
    line-height: 1.5;
  }

  .about__globe {
    inline-size: min(100%, 27rem);
    aspect-ratio: 1;
    justify-self: center;
  }

  .about__globe-window {
    border: 1px solid var(--color-hairline);
    border-radius: 50%;
    inline-size: min(100%, 27rem);
  }

  :global([data-globe-following]) .about__globe-window {
    border-color: transparent;
  }

  .about__details {
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(4rem, 8vw, 7rem);
    background: var(--color-void);
    pointer-events: auto;
  }

  .about--embedded .about__details {
    padding-block-end: clamp(1rem, 2.5vw, 2.5rem);
  }

  #services,
  #capabilities,
  #experience {
    scroll-margin-block-start: 6rem;
  }

  .about__capability-lead {
    margin-block-end: clamp(2.75rem, 8vw, 7rem);
  }

  #capabilities-title {
    margin-block-end: 0.65rem;
    font: 700 clamp(2rem, 5vw, 4.25rem)/1.05 var(--font-body);
    letter-spacing: -0.04em;
  }

  .about__capability-lead p {
    max-inline-size: 50ch;
    color: var(--color-muted);
    font-size: clamp(1.15rem, 2.35vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .about__details :is(h2, h3):where(#experience-title, #mindset-title) {
    margin-block: 0 1rem;
    font: 700 clamp(1.65rem, 3.6vw, 3.4rem)/1.08 var(--font-body);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .about__experience {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .about__record p {
    max-inline-size: 58ch;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .about__experience p + p { margin-block-start: 0.85rem; }

  .about__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.5rem);
    margin: 0;
  }

  .about__facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.3rem;
    padding-block: 0.9rem;
    border-block-start: 1px solid var(--color-hairline);
  }

  .about__facts dd {
    margin: 0;
    font: 700 clamp(1.65rem, 3vw, 2.4rem)/1 var(--font-display);
  }

  .about__facts dt {
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .about__note {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.8fr);
    align-items: center;
    gap: clamp(1.25rem, 5vw, 4rem);
    margin-block-start: clamp(3rem, 8vw, 7rem);
    padding-block-start: clamp(2rem, 5vw, 4rem);
    border-block-start: 1px solid var(--color-hairline);
  }

  .about__note a {
    margin-block-start: 0.75rem;
  }

  .about__signal {
    justify-self: end;
    inline-size: min(100%, 15rem);
    color: var(--color-signal);
  }

  .about__signal-track { stroke: var(--color-hairline); }
  .about__signal-route { stroke: currentColor; stroke-dasharray: 5 95; stroke-dashoffset: -53; }
  .about__signal circle { fill: currentColor; }

  .about__signal--handoff {
    inline-size: min(76%, 40rem);
    margin-block-start: clamp(1.25rem, 4vw, 3rem);
    margin-inline-start: auto;
  }

  .about__signal--handoff circle { opacity: 0.65; }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .about__signal-route {
        animation-name: trace-route;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 10% cover 47%;
      }
    }
  }

  @keyframes trace-route {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -95; }
  }

  @media (max-width: 42rem) {
    .about__experience { grid-template-columns: minmax(0, 1fr); }
    .about__note { grid-template-columns: minmax(0, 1fr); }
    .about__signal { inline-size: 7.5rem; }
    .about__signal--handoff { inline-size: min(82%, 20rem); }
    .about__intro {
      inline-size: 100%;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding-block: 0 1rem;
    }

    .about__intro-copy {
      padding: 6.25rem var(--page-gutter) 0;
      background: var(--color-void);
    }

    .about--embedded .about__opening {
      background: none;
    }

    .about__globe {
      inline-size: min(78%, 18rem);
    }

  }
</style>
