---
import AboutCapabilities from "./AboutCapabilities.astro";
import AboutGlobe from "./AboutGlobe.astro";

interface Props {
  scrollDriven?: boolean;
  showGlobe?: boolean;
}

const { scrollDriven = false, showGlobe = true } = Astro.props;
---

<section
  class="about"
  id="about"
  data-about
  data-about-scroll={scrollDriven ? "true" : "false"}
  aria-labelledby="about-title"
>

  <div class="about__rail" aria-hidden="true" data-about-technical>
    <span>Mindset</span><span>Build</span><span>Protect</span><span>Create</span><span>Scale</span><i></i>
  </div>

  <p class="about__direction" data-about-meta>
    Different challenges.<br />Same direction.<br />A more secure, functional and relevant tomorrow.
  </p>

  <h1 class="about__headline" id="about-title" data-about-headline>
    <span>We secure<em>.</em></span>
    <span>We engineer<em>.</em></span>
    <span>We position<em>.</em></span>
  </h1>

  <div class="about__copy" data-about-copy lang="en">
    <p>
      Z3nTry is a technology company with cybersecurity at its core, complemented by development
      and digital design capabilities.
    </p>
    <p>
      We work across the digital ecosystem to make it more secure, functional and relevant—building
      solutions tailored to each challenge rather than generic responses.
    </p>
  </div>

  <div class="about__capabilities">
    <AboutCapabilities />
  </div>

  <section class="about__mindset" aria-labelledby="mindset-title" data-about-footer lang="en">
    <p>Our mindset</p>
    <h2 id="mindset-title">Don't just react. <strong>Anticipate.</strong><br />Always one step ahead.</h2>
  </section>

  {showGlobe && (
    <div class="about__globe" data-about-globe-wrap>
      <AboutGlobe />
    </div>
  )}

  <div class="about__globe-message" data-about-message aria-hidden="true">
    <i class="about__message-backdrop" data-about-message-backdrop></i>
    <span data-about-message-copy>Always one</span>
    <strong data-about-message-copy>Step ahead.</strong>
  </div>

  <div class="about__coordinates" data-about-technical aria-hidden="true">
    <i></i><span>04.7110° N<br />074.0721° W</span>
  </div>

  <aside class="about__system" data-about-technical aria-hidden="true">
    <div class="about__system-grid"></div>
    <p class="about__system-top">Technology<br />People<br />A safer tomorrow</p>
    <p class="about__system-bottom">Ideas<br />Defense<br />Growth<br />Globally</p>
    <span class="cross cross--one">+</span>
    <span class="cross cross--two">+</span>
  </aside>

</section>

<script>
  import { setupAboutAnimation } from "../animations/about.gsap";

  let cleanupPage = (): void => undefined;

  function initializeAbout(): void {
    cleanupPage();
    const root = document.querySelector<HTMLElement>("[data-about]");
    const globe = root?.querySelector<HTMLElement>("[data-about-globe]");
    if (!root) return;

    const cleanupAnimation = root.dataset.aboutScroll === "true"
      ? () => undefined
      : setupAboutAnimation(root);
    let cleanupGlobe = (): void => undefined;
    let disposed = false;

    const globeLoadTimer = globe
      ? window.setTimeout(() => {
          void import("../animations/about-globe.client")
            .then(({ setupAboutGlobe }) => {
              if (!disposed) cleanupGlobe = setupAboutGlobe(globe);
            })
            .catch(() => {
              // The CSS fallback remains visible if WebGL initialization fails.
            });
        }, 120)
      : undefined;

    cleanupPage = () => {
      disposed = true;
      if (globeLoadTimer !== undefined) window.clearTimeout(globeLoadTimer);
      cleanupAnimation();
      cleanupGlobe();
    };
  }

  initializeAbout();
  document.addEventListener("astro:page-load", initializeAbout);
  document.addEventListener("astro:before-swap", () => cleanupPage());
  window.addEventListener("pagehide", () => cleanupPage(), { once: true });
</script>

<style>
  .about {
    position: relative;
    isolation: isolate;
    min-height: max(100svh, 55rem);
    overflow: hidden;
    background: var(--color-void);
  }

  .about__direction,
  .about__rail,
  .about__headline,
  .about__copy,
  .about__capabilities,
  .about__mindset {
    position: absolute;
    z-index: 4;
  }

  .about__direction {
    top: 14.5%;
    left: 30%;
    color: rgb(242 242 242 / 38%);
    font-family: var(--font-mono);
    font-size: clamp(0.54rem, 0.58vw, 0.64rem);
    letter-spacing: 0.11em;
    line-height: 1.65;
    text-transform: uppercase;
  }

  .about__headline {
    top: 25%;
    left: 11.5%;
    display: grid;
    color: var(--color-ash);
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .about__headline span {
    display: block;
  }

  .about__headline em {
    color: var(--color-signal);
    font-style: normal;
  }

  .about__rail {
    top: 14.5%;
    left: var(--page-gutter);
    display: grid;
    gap: 0.38rem;
    color: rgb(242 242 242 / 34%);
    font-family: var(--font-mono);
    font-size: clamp(0.5rem, 0.53vw, 0.58rem);
    letter-spacing: 0.12em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .about__rail span:first-child {
    margin-bottom: 0.35rem;
    color: rgb(242 242 242 / 54%);
  }

  .about__rail i {
    width: 2.4rem;
    height: 1px;
    margin-top: 0.4rem;
    background: rgb(242 242 242 / 14%);
  }

  .about__copy {
    top: 55%;
    left: 11.5%;
    width: min(24vw, 27rem);
    color: rgb(242 242 242 / 62%);
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 0.72vw, 0.8rem);
    letter-spacing: 0.025em;
    line-height: 1.7;
  }

  .about__copy p + p {
    margin-top: 0.8rem;
  }

  .about__capabilities {
    top: 54%;
    left: 36.5%;
    width: min(19vw, 20rem);
  }

  .about__mindset {
    bottom: 8.5%;
    left: 11.5%;
    color: rgb(242 242 242 / 48%);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .about__mindset > p {
    margin-bottom: 0.5rem;
    font-size: 0.54rem;
    letter-spacing: 0.18em;
  }

  .about__mindset h2 {
    color: rgb(242 242 242 / 78%);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 0.82vw, 0.92rem);
    font-weight: 400;
    letter-spacing: 0.09em;
    line-height: 1.55;
  }

  .about__mindset strong {
    color: var(--color-signal);
    font-weight: 400;
  }

  .about__globe {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: -19vw;
    width: min(83vw, 82rem);
    aspect-ratio: 1;
    opacity: 0.86;
    transform: translateY(-50%);
  }

  .about__globe-message {
    position: absolute;
    z-index: 5;
    top: 49%;
    right: auto;
    left: 75.5%;
    display: grid;
    min-width: clamp(16rem, 23vw, 25rem);
    padding: clamp(3.5rem, 5vw, 6rem);
    isolation: isolate;
    font-family: var(--font-mono);
    text-transform: uppercase;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .about__message-backdrop {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 50%;
    width: clamp(24rem, 38vw, 44rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(5 5 5 / 100%) 0 38%,
      rgb(5 5 5 / 94%) 51%,
      rgb(5 5 5 / 72%) 64%,
      rgb(5 5 5 / 34%) 76%,
      transparent 88%
    );
    transform: translate(-50%, -50%);
  }

  .about__globe-message span {
    color: rgb(242 242 242 / 62%);
    font-size: clamp(1.05rem, 1.7vw, 1.8rem);
    font-weight: 300;
    letter-spacing: 0.12em;
  }

  .about__globe-message strong {
    color: var(--color-signal);
    font-size: clamp(1.55rem, 2.65vw, 2.85rem);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .about__coordinates {
    position: absolute;
    z-index: 5;
    top: 56%;
    right: 15%;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: rgb(242 242 242 / 28%);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.12em;
    line-height: 1.6;
    pointer-events: none;
  }

  .about__coordinates i {
    width: 2.5rem;
    height: 1px;
    margin-top: 0.32rem;
    background: rgb(242 242 242 / 18%);
  }

  .about__system {
    position: absolute;
    z-index: 2;
    top: 12%;
    right: 0;
    bottom: 8%;
    width: 18vw;
    min-width: 12rem;
    color: rgb(242 242 242 / 22%);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.17em;
    line-height: 1.65;
    text-transform: uppercase;
    pointer-events: none;
  }

  .about__system-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(242 242 242 / 6%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(242 242 242 / 6%) 1px, transparent 1px);
    background-size: 4.25rem 4.25rem;
    mask-image: linear-gradient(to left, black, transparent 92%);
  }

  .about__system-top,
  .about__system-bottom {
    position: absolute;
    right: var(--page-gutter);
    text-align: right;
  }

  .about__system-top {
    top: 7%;
  }

  .about__system-bottom {
    bottom: 3%;
  }

  .cross {
    position: absolute;
    color: rgb(225 6 0 / 36%);
  }

  .cross--one {
    top: 32%;
    right: 33%;
  }

  .cross--two {
    right: 72%;
    bottom: 27%;
  }

  @media (max-width: 75rem) {
    .about__headline {
      left: 9%;
      font-size: clamp(2.8rem, 5.2vw, 4.7rem);
    }

    .about__copy,
    .about__mindset {
      left: 9%;
    }

    .about__capabilities {
      left: 33%;
      width: 19vw;
    }
  }

  @media (max-width: 63.99rem) {
    .about {
      min-height: max(100svh, 58rem);
    }

    .about__direction {
      left: 38%;
    }

    .about__headline {
      top: 27%;
      left: var(--page-gutter);
      font-size: clamp(2.65rem, 6vw, 4.1rem);
    }

    .about__copy,
    .about__mindset {
      left: var(--page-gutter);
    }

    .about__copy {
      width: 29vw;
    }

    .about__capabilities {
      left: 35%;
      width: 24vw;
    }

    .about__globe {
      right: -31vw;
      width: 95vw;
      opacity: 0.68;
    }

    .about__globe-message {
      left: 73%;
    }

    .about__coordinates,
    .about__system {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    .about {
      min-height: 100rem;
      overflow: hidden;
      padding: 0 var(--page-gutter);
    }

    .about__direction,
    .about__rail,
    .about__headline,
    .about__copy,
    .about__capabilities,
    .about__mindset {
      position: relative;
      inset: auto;
    }

    .about__rail {
      margin-top: 8.5rem;
    }

    .about__direction {
      margin-top: 2rem;
    }

    .about__headline {
      margin-top: 3.5rem;
      font-size: clamp(2.3rem, 11.5vw, 4rem);
      line-height: 0.94;
    }

    .about__copy {
      width: min(100%, 28rem);
      margin-top: 2.5rem;
    }

    .about__globe {
      top: 44rem;
      right: -47vw;
      width: 130vw;
      min-width: 35rem;
      opacity: 0.62;
      transform: none;
    }

    .about__globe-message {
      top: 58rem;
      right: auto;
      left: 66%;
      min-width: 16rem;
      padding: 3rem;
    }

    .about__capabilities {
      width: min(100%, 22rem);
      margin-top: 34rem;
    }

    .about__mindset {
      margin-top: 4rem;
    }

    .about__system,
    .about__coordinates {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
  }
</style>
