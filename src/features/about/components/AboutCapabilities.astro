---
import { aboutCapabilities } from "../data/capabilities";

interface Props {
  heading: "h3" | "h4";
}

const { heading: Heading } = Astro.props;
---

<ul class="capabilities" role="list">
  {aboutCapabilities.map(({ name, statement, description, services }) => (
    <li class="capability">
      <svg class="capability__diagram" viewBox="0 0 240 180" fill="none" aria-hidden="true">
        <path class="guide" d="M120 8v164M24 90h192" />
        {name === "Cybersecurity" && <>
          <circle class="guide" cx="120" cy="90" r="73" />
          <path class="secondary" d="M120 29 173 51v36c0 30-20 53-53 67-33-14-53-37-53-67V51Z" />
          <path d="m120 41 41 17v29c0 24-15 42-41 54-26-12-41-30-41-54V58Z" />
          <path class="secondary" d="M79 90h82m-41-49v100" />
          <path d="m108 91 8 8 16-18" class="signal" />
          <circle cx="67" cy="90" r="3" class="node" />
        </>}
        {name === "Development" && <>
          <path class="guide" d="m37 65 83-41 83 41v57l-83 41-83-41Z" />
          <path class="secondary" d="m57 91 63 31 63-31m-126 20 63 31 63-31m-126 20 63 31 63-31" />
          <path d="m57 74 63-31 63 31-63 31Z M57 74v17m126-17v17m-63 14v17" />
          <path class="signal" d="m102 74 18-9 18 9-18 9Z" />
          <circle cx="120" cy="122" r="3" class="node" />
        </>}
        {name === "Design" && <>
          <path class="guide" d="M41 30h158v120H41Z M41 21v18m-9-9h18m149-9v18m-9-9h18M41 141v18m-9-9h18m149-9v18m-9-9h18" />
          <rect x="52" y="42" width="136" height="96" rx="3" />
          <path class="secondary" d="M52 62h136m-68 0v76m-53-56h38m-38 10h25m-25 10h31" />
          <path d="m133 116 13-15 11 7 17-24" class="signal" />
          <circle cx="174" cy="84" r="3" class="node" />
        </>}
      </svg>
      <div class="capability__copy">
        <Heading>{statement}<span>.</span></Heading>
        <p class="capability__name">{name}</p>
        <p class="capability__description">{description}</p>
        <ul class="capability__services" role="list" aria-label={`${name} services`}>
          {services.map((service) => <li>{service}</li>)}
        </ul>
      </div>
    </li>
  ))}
</ul>

<style>
  .capabilities {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capability {
    min-inline-size: 0;
    padding-inline: clamp(1.25rem, 3vw, 3rem);
  }

  .capability:first-child { padding-inline-start: 0; }
  .capability:last-child { padding-inline-end: 0; }
  .capability + .capability { border-inline-start: 1px solid var(--color-hairline); }

  .capability__diagram {
    display: block;
    inline-size: min(100%, 17rem);
    margin: 0 auto clamp(1.5rem, 3vw, 2.75rem);
    color: var(--color-muted);
    stroke: currentColor;
    stroke-width: 1.15;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .guide { opacity: 0.22; stroke-dasharray: 2 5; }
  .secondary { opacity: 0.55; }
  .signal { stroke: var(--color-signal); stroke-width: 1.6; }
  .node { fill: var(--color-signal); stroke: none; }

  :is(h3, h4) {
    margin: 0 0 0.4rem;
    font: 700 clamp(1.25rem, 2.45vw, 2.15rem)/1.08 var(--font-display);
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  :is(h3, h4) span { color: var(--color-signal); }
  .capability__name { font-weight: 650; }

  .capability__description {
    max-inline-size: 43ch;
    margin-block-start: 0.85rem;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .capability__services {
    display: grid;
    gap: 0.45rem;
    margin: 1.35rem 0 0;
    padding: 1rem 0 0;
    border-block-start: 1px solid var(--color-hairline);
    color: var(--color-muted);
    list-style: none;
  }

  .capability__services li {
    position: relative;
    padding-inline-start: 0.85rem;
    line-height: 1.45;
  }

  .capability__services li::before {
    position: absolute;
    inset: 0.63em auto auto 0;
    inline-size: 0.25rem;
    block-size: 1px;
    background: currentColor;
    content: "";
  }

  @media (max-width: 52rem) {
    .capabilities { grid-template-columns: minmax(0, 1fr); }

    .capability,
    .capability + .capability {
      padding: clamp(1.5rem, 5vw, 2.5rem) 0;
      border-inline-start: 0;
      border-block-start: 1px solid var(--color-hairline);
    }

    .capability__diagram {
      inline-size: min(64%, 13rem);
      margin-block-end: 1.25rem;
    }
  }
</style>
