---
import { contactEmailHref } from "../data/contact-email";
---

<form class="contact-form" action={contactEmailHref} method="post" enctype="text/plain" data-contact-draft data-astro-reload>
  <div class="contact-form__fields">
    <label>
      Nombre
      <input name="name" autocomplete="name" maxlength="100" required />
    </label>
    <label>
      Correo
      <input name="email" type="email" autocomplete="email" maxlength="254" required />
    </label>
  </div>
  <label>
    Mensaje
    <textarea name="body" rows="4" maxlength="1000" required></textarea>
  </label>
  <button class="signal-link" type="submit">Enviar</button>
</form>

<script>
  import { buildContactDraft } from "../data/contact-email";

  document.addEventListener("submit", (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.matches("[data-contact-draft]")) return;
    event.preventDefault();
    const fields = new FormData(form);
    window.location.href = buildContactDraft(
      String(fields.get("name") ?? ""),
      String(fields.get("email") ?? ""),
      String(fields.get("body") ?? "")
    );
  });
</script>

<style>
  .contact-form,
  label {
    display: grid;
  }

  .contact-form {
    gap: 1.15rem;
    max-inline-size: 40rem;
    margin-block-start: 1.75rem;
  }

  .contact-form__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem;
  }

  label {
    gap: 0.45rem;
    font: 0.85rem/1.5 var(--font-mono);
  }

  input,
  textarea {
    inline-size: 100%;
    min-block-size: 2.75rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-muted);
    background: var(--color-void);
    color: var(--color-ash);
    font: 1rem/1.5 var(--font-body);
  }

  textarea { resize: vertical; }

  button {
    justify-self: start;
    padding-inline: 0.85rem 1rem;
    border: 1px solid var(--color-hairline);
    background: transparent;
    cursor: pointer;
    font: inherit;
  }

  @media (max-width: 36rem) {
    .contact-form__fields { grid-template-columns: minmax(0, 1fr); }
  }
</style>
