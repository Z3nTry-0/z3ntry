---
---

<section class="hero" id="home" data-hero aria-labelledby="hero-title">
  <div class="hero__signal" aria-hidden="true" data-hero-signal data-hero-transition></div>

  <div class="hero__identity" data-hero-transition>
    <h1 id="hero-title" data-hero-logo>
      <span class="sr-only">Z3nTry</span>
      <img src="/z3ntry.webp" width="1774" height="887" alt="" draggable="false" />
    </h1>
    <p class="hero__descriptor" data-hero-item>
      <span>Cybersecurity</span>
      <span>Technologies</span>
      <span>Design</span>
    </p>
  </div>

  <aside class="hero__note hero__note--top" aria-label="Visión" data-hero-item data-hero-transition>
    <p>A safer<br />tomorrow</p>
    <span class="note-line" aria-hidden="true"></span>
  </aside>

  <aside class="hero__note hero__note--bottom" aria-label="Alcance" data-hero-item data-hero-transition>
    <p>Ideas<br />defense<br />growth<br />globally</p>
    <span class="note-line" aria-hidden="true"></span>
  </aside>

  <div class="hero__coordinates" aria-hidden="true" data-hero-item data-hero-transition>
    <span>04.7110° N</span>
    <span>074.0721° W</span>
  </div>
</section>

<script>
  import { setupHeroAnimation } from "../animations/hero.gsap";

  let cleanupPage = (): void => undefined;

  function initializeHero(): void {
    cleanupPage();
    const root = document.querySelector<HTMLElement>("[data-hero]");
    if (!root) return;

    const cleanupHero = setupHeroAnimation(root);
    const preventCopy = (event: ClipboardEvent): void => event.preventDefault();
    const preventDrag = (event: DragEvent): void => event.preventDefault();

    root.addEventListener("copy", preventCopy);
    root.addEventListener("dragstart", preventDrag);

    cleanupPage = () => {
      root.removeEventListener("copy", preventCopy);
      root.removeEventListener("dragstart", preventDrag);
      cleanupHero();
    };
  }

  initializeHero();
  document.addEventListener("astro:page-load", initializeHero);
  document.addEventListener("astro:before-swap", () => cleanupPage());
  window.addEventListener("pagehide", () => cleanupPage(), { once: true });
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-void);
    user-select: none;
    -webkit-user-select: none;
  }

  .hero__signal {
    position: absolute;
    z-index: 1;
    top: 49%;
    left: 8%;
    width: clamp(3rem, 7vw, 7rem);
    height: 2px;
    background: var(--color-signal);
    transform: rotate(-4deg);
    transform-origin: right;
  }

  .hero__signal::after {
    position: absolute;
    top: -3px;
    right: -0.15rem;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--color-signal);
    content: "";
    transform: rotate(18deg);
  }

  .hero__identity {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 50%;
    width: min(50vw, 50rem);
    transform: translate(-50%, -50%);
  }

  h1 {
    width: 100%;
    line-height: 0;
  }

  h1 img {
    width: 100%;
    height: auto;
    filter: contrast(1.08);
    pointer-events: none;
    -webkit-user-drag: none;
  }

  .hero__descriptor {
    display: flex;
    justify-content: center;
    gap: clamp(1.25rem, 4vw, 4.5rem);
    margin-top: clamp(-1rem, -1.4vw, -0.3rem);
    width: 100%;
    padding-left: 0;
    color: rgb(242 242 242 / 76%);
    font-family: var(--font-mono);
    font-size: clamp(0.58rem, 0.78vw, 0.78rem);
    letter-spacing: 0.24em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero__note {
    position: absolute;
    z-index: 4;
    right: var(--page-gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.65rem;
    color: rgb(242 242 242 / 46%);
    font-family: var(--font-mono);
    font-size: clamp(0.55rem, 0.62vw, 0.68rem);
    letter-spacing: 0.2em;
    line-height: 1.55;
    text-align: right;
    text-transform: uppercase;
  }

  .hero__note--top {
    top: 17%;
    right: auto;
    left: var(--page-gutter);
    align-items: flex-start;
    text-align: left;
  }

  .hero__note--bottom {
    right: calc(var(--page-gutter) + 0.25rem);
    bottom: 12%;
  }

  .note-line {
    width: 2.7rem;
    height: 1px;
    background: var(--color-hairline);
  }

  .hero__note--bottom .note-line {
    width: 2.7rem;
    height: 1px;
  }

  .hero__coordinates {
    position: absolute;
    z-index: 4;
    top: 45%;
    right: var(--page-gutter);
    display: grid;
    gap: 0.35rem;
    color: rgb(242 242 242 / 30%);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.13em;
    text-align: right;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 63.99rem) {
    .hero__identity {
      left: 50%;
      width: min(60vw, 42rem);
    }

    .hero__coordinates,
    .hero__note--bottom {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    .hero__identity {
      top: 52%;
      left: 50%;
      width: min(74vw, 29rem);
      transform: translate(-50%, -50%);
    }

    .hero__descriptor {
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      margin-top: -0.15rem;
      padding-left: 0;
      letter-spacing: 0.18em;
    }

    .hero__note--top {
      top: 27%;
      right: auto;
      left: var(--page-gutter);
    }

    .hero__signal {
      top: 48%;
      left: 0;
    }

  }

  @media (max-height: 40rem) and (min-width: 48rem) {
    .hero__identity {
      width: min(54vw, 54rem);
    }

    .hero__note--top {
      top: 13%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
  }
</style>
