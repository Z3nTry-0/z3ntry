---
import SiteFooter from "../components/shell/SiteFooter.astro";
import ContactSection from "../features/contact/components/ContactSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contacto | Z3nTry: ciberseguridad y desarrollo de software"
  description="Contacta a Z3nTry para auditorías de ciberseguridad, pentesting, desarrollo de software o diseño digital. Escríbenos a contact@z3ntry.com."
 active="contact" showUtilities={false}>
  <main>
    <ContactSection standalone />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  main {
    min-block-size: calc(100svh - 3.25rem);
  }
</style>
