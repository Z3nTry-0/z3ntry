---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";

import GlobalTerminal from "../components/shell/GlobalTerminal.astro";
import GlobalScrollControl from "../components/shell/GlobalScrollControl.astro";
import SeoHead from "../components/shell/SeoHead.astro";
import SiteHeader from "../components/shell/SiteHeader.astro";
import { instagram } from "../features/contact/data/contact-links";

import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active?: "home" | "about" | "services" | "experience" | "contact";
  scrollTarget?: string;
  showUtilities?: boolean;
}

const { title, description, active = "home", scrollTarget = "/#about", showUtilities = true } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} sameAs={[instagram.href]} />
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <SiteHeader active={active} />
    {showUtilities && (
      <div data-shell-utilities>
        <GlobalTerminal />
        <GlobalScrollControl target={scrollTarget} />
      </div>
    )}
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
