---
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";

import GlobalTerminal from "../components/shell/GlobalTerminal.astro";
import GlobalScrollControl from "../components/shell/GlobalScrollControl.astro";
import SiteHeader from "../components/shell/SiteHeader.astro";

import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active?: "home" | "about" | "services" | "experience" | "contact";
  scrollTarget?: string;
}

const { title, description, active = "home", scrollTarget = "/#about" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/webp" href="/z3ntry.webp" />
    <title>{title}</title>
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <SiteHeader active={active} />
    <GlobalTerminal />
    <GlobalScrollControl target={scrollTarget} />
    <slot />
    <SpeedInsights/>
  </body>
</html>
