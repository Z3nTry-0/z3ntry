---
interface Props {
  active?: "home" | "about" | "services" | "experience" | "contact";
}

const { active = "home" } = Astro.props;

const items = [
  { id: "home", index: "1", label: "Home", href: "/#home" },
  { id: "about", index: "2", label: "About", href: "/#about" },
  { id: "services", index: "3", label: "Services", href: "/services" },
  { id: "experience", index: "4", label: "Experience", href: "/experience" },
  { id: "contact", index: "5", label: "Contact", href: "/contact" }
] as const;
---

<header class="site-header">
  <nav aria-label="Navegación principal">
    <ul>
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={{ active: item.id === active }}
            aria-current={item.id === active ? "page" : undefined}
            data-nav-section={item.id === "home" || item.id === "about" ? item.id : undefined}
          >
            <span aria-hidden="true">{item.index}:</span>[{item.label}]
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 40;
    top: clamp(1.4rem, 4vh, 3rem);
    left: var(--page-gutter);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem clamp(1rem, 2.5vw, 2.8rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    position: relative;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 0.78vw, 0.86rem);
    letter-spacing: 0.05em;
    transition: color 160ms ease;
  }

  a::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 1px;
    background: var(--color-signal);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  a:hover,
  a:focus-visible,
  a.active {
    color: var(--color-ash);
  }

  a.active {
    color: var(--color-signal);
  }

  a:hover::after,
  a:focus-visible::after,
  a.active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (max-width: 47.99rem) {
    .site-header {
      right: var(--page-gutter);
    }

    ul {
      display: grid;
      grid-template-columns: repeat(3, max-content);
    }

    li:nth-child(4),
    li:nth-child(5) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a,
    a::after {
      transition: none;
    }
  }
</style>
