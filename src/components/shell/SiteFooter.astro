---
import { instagram } from "../../features/contact/data/contact-links";
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <p>© {year} Z3nTry</p>
  <nav aria-label="Enlaces de Z3nTry">
    <a class="signal-link" href={instagram.href}>Instagram</a>
  </nav>
  <p lang="en">Powered by <a href="https://www.darwinlatorre.com/">Darwinlatorre</a></p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0 1.5rem;
    inline-size: var(--page-frame);
    margin-inline: auto;
    padding-block: 0.25rem;
    border-block-start: 1px solid var(--color-hairline);
    background: var(--color-void);
    color: var(--color-muted);
    font: 0.75rem/1.5 var(--font-mono);
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: 2.75rem;
    color: var(--color-ash);
  }

  p a:is(:hover, :focus-visible) {
    color: var(--color-muted);
  }

  @media (max-width: 35rem) {
    .site-footer {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 0.75rem;
    }
  }
</style>
