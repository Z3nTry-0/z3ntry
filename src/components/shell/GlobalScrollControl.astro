---
interface Props {
  target?: string;
}

const { target = "/#about" } = Astro.props;
---

<a class="global-scroll" href={target} aria-label="Ir a la siguiente sección">
  <span>Scroll down</span>
  <svg viewBox="0 0 18 12" width="18" height="12" aria-hidden="true">
    <path d="m2 2 7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.25"></path>
  </svg>
</a>

<style>
  .global-scroll {
    position: fixed;
    z-index: 40;
    bottom: clamp(1.4rem, 4.5vh, 3.25rem);
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .global-scroll span {
    color: rgb(242 242 242 / 48%);
  }

  .global-scroll svg {
    animation: global-scroll-pulse 2.6s ease-in-out infinite;
  }

  .global-scroll:hover svg,
  .global-scroll:focus-visible svg {
    animation-play-state: paused;
    transform: translateY(0.22rem);
  }

  @keyframes global-scroll-pulse {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(0.22rem);
    }
  }

  @media (max-width: 47.99rem) {
    .global-scroll {
      right: var(--page-gutter);
      left: auto;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .global-scroll svg {
      animation: none;
    }
  }
</style>
